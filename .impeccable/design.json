      "html": "<nav class=\"ds-nav\" aria-label=\"Main navigation\"><a href=\"#projects\">Projects</a><a href=\"#about\">About</a><a class=\"ds-contact\" href=\"mailto:JD@jboxgames.com\">Say hello <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M6 18 18 6M6 6h12v12\"/></svg></a></nav>",
