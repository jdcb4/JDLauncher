  "narrative": {
    "northStar": "The Independent Games Workshop",
    "overview": "A compact developer homepage with warm surfaces, clear game artwork and direct contact information. No decorative PLAY hand or redundant calls to action.",
    "keyCharacteristics": [
      "Cotton surfaces and charcoal text.",
      "Compact spacing and characterful typography.",
      "Exactly one artwork link per game.",
      "No decorative entrance animation."
    ],
    "rules": [
      {
        "name": "The Contrast Rule",
        "body": "Keep body text in ink or muted gray on cotton; amber is a detail color, with brown lettering when it becomes a surface.",
        "section": "colors"
      }
    ],
    "dos": [
      "Keep local fonts and visible keyboard focus.",
      "Keep the page compact and clear.",
      "Keep one artwork link per game."
    ],
    "donts": [
      "Do not restore the PLAY hand or redundant slogans.",
      "Do not add a project CTA pointing immediately below itself.",
      "Do not make Google Play interactive without a real supplied URL."
    ]
  }
}
