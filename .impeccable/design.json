      "html": "<a class=\"ds-primary\" href=\"/\">Back to JBOXGames <svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M12 5v14m-6-6 6 6 6-6\"/></svg></a>",
